{
    "pack": {
        "min_format": [121],
        "max_format": [121],
        "description": [
            {
                "text": "Adds some vanilla+ recipes and features",
                "color": "green"
            }
        ]
    },
    "filter": {
        "block": [
            {
                "namespace": "minecraft",
                "path": "^recipe/.+stonecutting\\.json$"
            },
            {
                "namespace": "minecraft",
                "path": "^advancement/recipes/.+stonecutting\\.json$"
            },
            {
                "namespace": "minecraft",
                "path": "^recipe/\\w+_stained_glass(?:_pane_from_glass_pane)?\\.json$"
            },
            {
                "namespace": "minecraft",
                "path": "^advancement/recipes/\\w+/\\w+_stained_glass(?:_pane_from_glass_pane)?\\.json$"
            },
            {
                "namespace": "minecraft",
                "path": "^recipe/(?!.*glazed)\\w+_terracotta\\.json$"
            },
            {
                "namespace": "minecraft",
                "path": "^advancement/recipes/\\w+/(?!.*glazed)\\w+_terracotta\\.json$"
            }
        ]
    }
}